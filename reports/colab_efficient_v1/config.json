{
  "architecture": {
    "attention_probs_dropout_prob": 0.1,
    "hidden_dropout_prob": 0.1,
    "hidden_size": 512,
    "intermediate_size": 2048,
    "max_position_embeddings": 512,
    "num_attention_heads": 8,
    "num_hidden_layers": 8,
    "vocab_size": 50265
  },
  "colab": {
    "checkpoint_every_seconds": 300.0,
    "checkpoint_every_updates": 100,
    "gradient_checkpointing": false,
    "require_full_dataset": true
  },
  "label_order": [
    "identity_hate",
    "insult",
    "obscene",
    "severe_toxic",
    "threat",
    "toxic"
  ],
  "method": "random_initialized_roberta",
  "training": {
    "accumulation_steps": 4,
    "amp": true,
    "batch_size": 64,
    "cache_tokenization": true,
    "conflict_policy": "keep",
    "cpu_threads": 2,
    "device": "cuda",
    "dynamic_padding": true,
    "empty_text_policy": "drop",
    "epochs": 5,
    "learning_rate": 4e-05,
    "local_files_only": false,
    "max_gradient_norm": 1.0,
    "max_length": 256,
    "num_workers": 0,
    "patience": 3,
    "seed": 42,
    "tokenizer_name_or_path": "roberta-base",
    "tokenizer_revision": null,
    "warmup_fraction": 0.1,
    "weight_decay": 0.01
  }
}
